# Discord bot yapılandırması.
# Bu dosyayı ".env" adıyla kopyalayıp değerleri doldurun.
# BURAYA GERÇEK DEĞER YAZMAYIN — bu dosya paylaşılabilir olmalıdır.

# --- Çekirdek (üçü de zorunlu) ---

# Bot token'ı. Developer Portal > Bot > Reset Token. GİZLİ, kimseyle paylaşmayın.
token =

# Uygulama (application) kimliği. Developer Portal > General Information.
clientID =

# Botun çalışacağı TEK sunucunun kimliği. Slash komutlar buraya kaydedilir;
# bot başka bir sunucuya eklenirse kendiliğinden ayrılır.
# Discord > Ayarlar > Gelişmiş > Geliştirici Modu açık iken
# sunucuya sağ tık > "Sunucu Kimliğini Kopyala".
guildID =

# --- Yetkililer ---

# Bot sahibinin Discord kullanıcı kimliği. Sahibe özel komutlar (/yedek) ve
# yönetici muz çarpanı buna bakar; Yönetim paneli istatistiklerinde bu kişiler
# gizlenebilir. (Activity Yönetim paneli ise Discord'daki Yönetici iznine bakar.)
# Boş bırakılırsa bu yetkileri KİMSE kullanamaz — kapalı tarafa düşmek bilinçli.
authorUserID =

# Sahip dışında aynı yetkilere sahip geliştiriciler.
# Virgülle ayrılmış kullanıcı kimlikleri, örn: 111111111111111111,222222222222222222
developerUserIDs =

# --- Discord Activity (activity/ ön yüzü; isteğe bağlı) ---

# OAuth2 uygulama sırrı: Activity girişinde kodu belirtece çevirmek için.
# Bot girişi ve slash komutlar için GEREKMEZ. GİZLİ.
clientSecret =

# Activity API'sinin dinleyeceği yerel port (yalnız 127.0.0.1; dışarıya nginx açar).
# Boşsa API kapalı.
webPort =

# activity/ içinde `npm run yayinla` derlemeyi bu web köküne kopyalar (mutlak yol).
yayinDizini =

# --- Commit notları (isteğe bağlı; scripts/guncelleme-notu.js) ---

# Her commit'in duyurulacağı kanal ve yeni notta etiketlenecek rol (boşsa etiket yok).
guncellemeKanalID =
guncellemeRolID =

# --- Destek talebi asistanı (isteğe bağlı; lib/talep-yz.js) ---

# Claude Code CLI'nin yolu. Varsayılan ~/.local/bin/claude; kurulu değilse
# asistan hiçbir şey yapmaz.
# CLAUDE_YOLU =
